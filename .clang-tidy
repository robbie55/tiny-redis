
Checks: >
  -*,
  bugprone-*,
  clang-analyzer-*,
  concurrency-*,
  cppcoreguidelines-*,
  misc-*,
  modernize-*,
  performance-*,
  portability-*,
  readability-*,
  -bugprone-easily-swappable-parameters,
  -cppcoreguidelines-avoid-magic-numbers,
  -cppcoreguidelines-non-private-member-variables-in-classes,
  -cppcoreguidelines-pro-bounds-array-to-pointer-decay,
  -cppcoreguidelines-pro-bounds-avoid-unchecked-container-access,
  -cppcoreguidelines-pro-bounds-constant-array-index,
  -cppcoreguidelines-pro-bounds-pointer-arithmetic,
  -cppcoreguidelines-pro-type-reinterpret-cast,
  -misc-non-private-member-variables-in-classes,
  -misc-no-recursion,
  -modernize-use-trailing-return-type,
  -readability-identifier-length,
  -readability-magic-numbers

# Enabled:
#   bugprone-*           likely bugs: uninit, narrowing, dangling. Cheap and accurate.
#   clang-analyzer-*     data-flow analysis. Catches what lints can't, e.g. use-after-free
#                        across branches.
#   concurrency-*        rarely fires on a single-threaded loop. Costs nothing to keep.
#   cppcoreguidelines-*  the C++ Core Guidelines. Several pro-* checks are too strict for
#                        systems code, see the disables below.
#   misc-*               grab bag, incl. misc-include-cleaner and misc-const-correctness.
#   modernize-*          smart pointers, range-for, override, using over typedef.
#   performance-*        copy, move and string smells.
#   portability-*        implementation-defined behaviour. We target Linux and macOS.
#   readability-*        structure: long functions, deep nesting, implicit bool
#                        conversions. clang-format handles whitespace.
#
# Disabled:
#   bugprone-easily-swappable-parameters
#       Fires on every function with two same-typed parameters, like takeBytes(in, at,
#       len). Too noisy.
#   cppcoreguidelines-avoid-magic-numbers / readability-magic-numbers
#       Fires on every literal other than 0 and 1. Protocol code is full of fixed byte
#       counts, like the 2 in a CRLF.
#   cppcoreguidelines-non-private-member-variables-in-classes /
#   misc-non-private-member-variables-in-classes
#       Both forbid public data members, but plain aggregates are fine as structs. Keeping
#       both on would also double every diagnostic.
#   cppcoreguidelines-pro-bounds-array-to-pointer-decay
#       Fires on assert() and ordinary C-string interop. Satisfying it needs gsl::span
#       everywhere, and we don't use GSL.
#   cppcoreguidelines-pro-bounds-constant-array-index
#       Flags every runtime index into a std::array, like Command::argv[i] in the parse
#       loop. The fix it wants is gsl::at().
#   cppcoreguidelines-pro-bounds-avoid-unchecked-container-access
#       The same check extended to std::vector and std::string_view, so it hits every
#       buffer index on the hot path. Arity checks and length validation enforce bounds
#       here, not a check per access.
#   cppcoreguidelines-pro-bounds-pointer-arithmetic
#       Flags every char* loop in buffer code. Use std::span where it fits.
#   cppcoreguidelines-pro-type-reinterpret-cast
#       A pool allocator reinterprets raw storage as a free-list node while free and as a
#       T while live. No static_cast does that, so the check fires on the lines that
#       matter.
#   misc-no-recursion
#       Recursion is a normal tool.
#   modernize-use-trailing-return-type
#       Wants `auto f() -> int` over `int f()`, which is harder to scan.
#   readability-identifier-length
#       Forbids one-character names, which rules out `i` in a loop.

# Every enabled diagnostic is an error. Run clang-tidy through `./scripts/dev.sh tidy`
# rather than CMAKE_CXX_CLANG_TIDY, which would fail every build on any hit. clangd shows
# the same checks in the editor.
WarningsAsErrors: '*'

# Without a filter, clang-tidy reports on every header it sees, libstdc++ and FetchContent
# deps included. This keeps project headers and skips build/, where the deps land.
HeaderFilterRegex: '.*tiny-redis/(?!build/).*\.(h|hh|hpp|hxx)$'

# `clang-tidy --fix` follows .clang-format instead of LLVM defaults.
FormatStyle: file

# Naming:
#   types, enums, aliases, template params   CamelCase
#   functions, methods                       camelBack
#   variables, parameters, members           camelBack
#   private/protected members                camelBack_
#   constants, constexpr, enum constants     kCamelCase
#   namespaces                               lower_case
#   macros                                   UPPER_CASE
CheckOptions:
  # ---- Naming ----
  - { key: readability-identifier-naming.ClassCase,                value: CamelCase }
  - { key: readability-identifier-naming.StructCase,               value: CamelCase }
  - { key: readability-identifier-naming.EnumCase,                 value: CamelCase }
  - { key: readability-identifier-naming.UnionCase,                value: CamelCase }
  - { key: readability-identifier-naming.TypeAliasCase,            value: CamelCase }
  - { key: readability-identifier-naming.TypedefCase,              value: CamelCase }
  - { key: readability-identifier-naming.TemplateParameterCase,    value: CamelCase }

  - { key: readability-identifier-naming.FunctionCase,             value: camelBack}
  - { key: readability-identifier-naming.MethodCase,               value: camelBack}

  - { key: readability-identifier-naming.VariableCase,             value: camelBack }
  - { key: readability-identifier-naming.ParameterCase,            value: camelBack }
  - { key: readability-identifier-naming.LocalVariableCase,        value: camelBack }

  - { key: readability-identifier-naming.MemberCase,               value: camelBack }
  - { key: readability-identifier-naming.ClassMemberCase,          value: camelBack }
  - { key: readability-identifier-naming.PrivateMemberCase,        value: camelBack }
  - { key: readability-identifier-naming.PrivateMemberSuffix,      value: '_' }
  - { key: readability-identifier-naming.ProtectedMemberCase,      value: camelBack }
  - { key: readability-identifier-naming.ProtectedMemberSuffix,    value: '_' }
  - { key: readability-identifier-naming.PublicMemberCase,         value: camelBack }

  - { key: readability-identifier-naming.ConstexprVariableCase,    value: CamelCase }
  - { key: readability-identifier-naming.ConstexprVariablePrefix,  value: 'k' }
  - { key: readability-identifier-naming.GlobalConstantCase,       value: CamelCase }
  - { key: readability-identifier-naming.GlobalConstantPrefix,     value: 'k' }
  - { key: readability-identifier-naming.StaticConstantCase,       value: CamelCase }
  - { key: readability-identifier-naming.StaticConstantPrefix,     value: 'k' }
  - { key: readability-identifier-naming.EnumConstantCase,         value: CamelCase }
  - { key: readability-identifier-naming.EnumConstantPrefix,       value: 'k' }

  - { key: readability-identifier-naming.NamespaceCase,            value: lower_case }
  - { key: readability-identifier-naming.MacroDefinitionCase,      value: UPPER_CASE }

  # ---- Complexity bounds ----
  # Default is 25. 20 forces tangled functions to split.
  - { key: readability-function-cognitive-complexity.Threshold,    value: '20' }

  # Each threshold fires independently.
  - { key: readability-function-size.LineThreshold,                value: '80' }
  - { key: readability-function-size.StatementThreshold,           value: '50' }
  - { key: readability-function-size.BranchThreshold,              value: '10' }
  - { key: readability-function-size.ParameterThreshold,           value: '5' }
  - { key: readability-function-size.NestingThreshold,             value: '4' }
  - { key: readability-function-size.VariableThreshold,            value: '15' }

  # ---- modernize tuning ----
  # Leave `int i = 0` alone. auto is for long type names.
  - { key: modernize-use-auto.MinTypeNameLength,                   value: '5' }
  # Prefer `= default` and `= delete` over hand-written empty bodies.
  - { key: modernize-use-equals-default.IgnoreMacros,              value: 'true' }

  # ---- bugprone tuning ----
  # Macros checked for side effects. A side effect inside assert() vanishes under NDEBUG.
  - { key: bugprone-assert-side-effect.AssertMacros,
      value: 'assert,NSAssert,NSCAssert' }

  # ---- readability tuning ----
  # `if (n)` must be `if (n != 0)`, and the same for pointers.
  - { key: readability-implicit-bool-conversion.AllowIntegerConditions, value: 'false' }
  - { key: readability-implicit-bool-conversion.AllowPointerConditions, value: 'false' }
